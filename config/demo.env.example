# Copy to config/demo.env (git-ignored) to override anything scripts/lib.sh detects from your `oc` login.
# Everything is optional; defaults shown.

# DEMO_NS=ai-governance-demo          # guardrails, workbench, alert inbox, audit workspace
# MODEL_NS=llm                         # where aigov-qwen3-8b / aigov-small are served (gets the MaaS gateway-access label)
# MAAS_NS=models-as-a-service          # MaaS tenant namespace
# MONITORING_NS=redhat-ods-monitoring  # DSCI monitoring namespace
# BRAND="Acme Bank"

# Detected automatically; set only if detection fails on your cluster:
# MAAS_URL=https://maas.apps.example.com
# DASH_URL=https://rh-ai.apps.example.com
# KEYCLOAK_URL=https://sso.apps.example.com
# KEYCLOAK_REALM=sso
# LLM_TEMPLATE=v3-5-2-kserve-config-llm-single-node-template-nvidia-cuda
# GPU_MACHINESET=<cluster>-gpu-worker-...    # used by setup.sh --gpu-nodes N

# Model (any Red Hat validated modelcar that fits one GPU):
# MODEL_URI=oci://registry.redhat.io/rhelai1/modelcar-qwen3-8b-fp8-dynamic:1.5
# MODEL_SERVED_NAME=RedHatAI/Qwen3-8B-FP8-dynamic

# Optional Loki object storage (setup.sh --with-loki); otherwise the toolkit SeaweedFS in s3-storage is used:
# LOKI_S3_ENDPOINT=https://s3.example.com
# LOKI_S3_BUCKET=loki-usage
# LOKI_S3_ACCESS_KEY=...
# LOKI_S3_SECRET_KEY=...

# Workbench (setup.sh --with-workbench) uses the rhoai-toolkit workbench helper:
# TOOLKIT_DIR=$HOME/Openshift-installation

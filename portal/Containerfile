# AI audit portal (Streamlit) for the AI governance demo. Build context: this folder (scripts/deploy-audit-portal.sh).
FROM registry.access.redhat.com/ubi9/python-312:latest
WORKDIR /opt/app-root/src/portal
COPY --chown=1001:0 requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY --chown=1001:0 portal.py .
USER 1001
ENV HOME=/opt/app-root/src PYTHONUNBUFFERED=1 STREAMLIT_BROWSER_GATHER_USAGE_STATS=false
EXPOSE 8501
CMD ["streamlit", "run", "portal.py", "--server.address=0.0.0.0", "--server.port=8501", "--server.headless=true", "--server.enableXsrfProtection=true"]
